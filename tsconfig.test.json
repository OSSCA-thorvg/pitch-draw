{
  // 테스트용. 검사 규칙은 본 설정 그대로 쓰고 두 가지만 바꾼다 —
  // `*.test.ts` 를 다시 들이고(본 설정은 배포물에서 뺀다), node 전역을 연다.
  // 산출물은 `dist-test/` 로 따로 뺀다. `dist/` 는 브라우저에 얹는 것만 들어 있어야 한다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-test",
    "types": ["node"],
    "sourceMap": false
  },
  "include": ["src", "vendor/webcanvas.esm.d.ts"],
  "exclude": []
}
